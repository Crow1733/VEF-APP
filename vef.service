[Unit]
Description=VEF App
After=network.target

[Service]
Type=simple
User=polterghast
WorkingDirectory=/home/polterghast/Programas/VEF/VEF-APP/backend
ExecStart=/home/polterghast/Programas/.venv/bin/uvicorn main:app \
    --host 0.0.0.0 \
    --port 8765 \
    --ssl-keyfile /home/polterghast/Programas/VEF/VEF-APP/ssl/key.pem \
    --ssl-certfile /home/polterghast/Programas/VEF/VEF-APP/ssl/cert.pem
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
